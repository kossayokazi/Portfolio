{
  "name": "kossay-portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "CONTACT_EMAIL": "kossayokkazi5678@gmail.com"
  },
  "previews": {
    "vars": {
      "CONTACT_EMAIL": "kossayokkazi5678@gmail.com"
    },
    "ai": { "binding": "AI" },
    "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "ASK_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  }
}